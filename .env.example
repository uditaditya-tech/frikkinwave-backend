# Copy this to .env and fill in the values.
# .env is git-ignored. .env.example is committed.

# Django
DJANGO_SECRET_KEY=replace-me-with-a-real-secret-key
DATABASE_URL=postgres://postgres:postgres@localhost:5432/frikkinwave

# Seconds to keep a Postgres connection open for reuse across requests. Django's
# own default is 0 (a new connection every request), which measured 16.9ms of
# handshake against a 0.58ms query on RDS. 0 disables reuse.
DJANGO_CONN_MAX_AGE=60

# Production only
ALLOWED_HOSTS=api.frikkinwave.com,frikkinwave.fly.dev
CORS_ALLOWED_ORIGINS=https://frikkinwave.com,https://www.frikkinwave.com

# Email (production)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=noreply@frikkinwave.com

# OpenAI (Phase 2)
OPENAI_API_KEY=sk-...
# Semantic-search similarity floor (0..1): drop results scoring below this.
# 0.0 disables. text-embedding-3-small scores low even for related text
# (strong ~0.72-0.78, moderate ~0.45-0.55), so keep this modest.
SEARCH_SIMILARITY_THRESHOLD=0.4

# Search (OpenSearch)
# Empty is fine: search degrades to an empty result set with no cluster, so
# `runserver` and the test suite need no container. Start one with
# `docker compose up -d opensearch` and set this to use it for real.
OPENSEARCH_URL=
OPENSEARCH_INDEX=profiles
OPENSEARCH_TIMEOUT=3.0

# Kafka (the only event transport — see KAFKA.md)
# Events go to Kafka. Empty locally: `runserver` does not need a broker, and the
# test suite relays in-process (EVENT_RELAY_INLINE, set under pytest).
# To run against a real broker locally, set these and run:
#     python manage.py relay_outbox --loop
#     python manage.py consume_events --group social
# Port the relay serves Prometheus gauges on, in `--loop` mode only. A stalled
# relay is invisible to every Kafka-side alert — nothing reaches the broker to
# be lagged on — so this endpoint is what makes its own liveness alertable.
EVENT_RELAY_METRICS_PORT=9100

KAFKA_BOOTSTRAP_SERVERS=
KAFKA_SECURITY_PROTOCOL=SSL
